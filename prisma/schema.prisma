generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TOURIST
  GUIDE
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum GuideVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum GuideRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ConversationType {
  GUIDE_REQUEST
  SUPPORT
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum LocationSource {
  GPS
  MANUAL
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationType {
  GUIDE_REQUEST_RECEIVED
  GUIDE_REQUEST_ACCEPTED
  GUIDE_REQUEST_REJECTED
  NEW_MESSAGE
  TRIP_REMINDER
  TRIP_COMPLETED
  NEW_REVIEW
  SYSTEM
}

enum AiConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique
  passwordHash        String     @map("password_hash")
  fullName            String     @map("full_name")
  phone               String?
  avatarUrl           String?    @map("avatar_url")
  role                UserRole   @default(TOURIST)
  status              UserStatus @default(ACTIVE)
  emailVerificationAt DateTime?  @map("email_verification_at")
  lastLoginAt         DateTime?  @map("last_login_at")

  guideProfile       GuideProfile?
  touristProfile     TouristProfile?
  refreshSessions    RefreshSession[]
  conversationMember ConversationMember[]
  messages           Message[]
  aiConversations    AiConversation[]

  sentGuideRequests GuideRequest[]        @relation("TouristRequest")
  guideRequest      GuideRequest[]        @relation("GuideRequest")
  reviewsGiven      Review[]              @relation("ReviewsGiven")
  reviewsReceived   Review[]              @relation("ReviewsReceived")
  currentLocation   UserCurrentLocation?
  locationHistory   UserLocationHistory[]
  notifications     Notification[]

  createdAt DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt DateTime? @db.Timestamptz(6) @map("deleted_at")

  @@index([role, status])
  @@map("users")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @db.Uuid @map("family_id")
  deviceName String?   @map("device_name")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  expriesAt  DateTime  @db.Timestamptz(6) @map("expires_at")
  lastUsedAt DateTime? @db.Timestamptz(6) @map("last_used_at")
  revokedAt  DateTime? @db.Timestamptz(6) @map("revoked_at")
  createdAt  DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_sessions")
}

model GuideProfile {
  userId             String                  @id @db.Uuid @map("user_id")
  bio                String?
  yearsExperience    Int                     @default(0) @map("years_experience")
  hourlyRate         Decimal?                @db.Decimal(12, 0) @map("hourly_rate")
  currency           String                  @default("VND") @db.Char(3)
  isAvailable        Boolean                 @default(false) @map("is_available")
  verificationStatus GuideVerificationStatus @default(UNVERIFIED) @map("verification_status")
  averageRating      Decimal                 @default(0) @db.Decimal(3, 2) @map("average_rating")
  reviewCount        Int                     @default(0) @map("review_count")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([isAvailable, verificationStatus])
  @@map("guide_profiles")
}

model TouristProfile {
  userId            String  @id @db.Uuid @map("user_id")
  preferredLanguage String? @map("preferred_language")
  nationality       String?
  travelPreferences Json?   @map("travel_preferences")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@map("tourist_profiles")
}

model GuideRequest {
  id                String             @id @default(uuid()) @db.Uuid
  touristId         String             @db.Uuid @map("tourist_id")
  guideId           String             @db.Uuid @map("guide_id")
  title             String
  description       String?
  status            GuideRequestStatus @default(PENDING)
  startAt           DateTime           @db.Timestamptz(6) @map("start_at")
  endAt             DateTime           @db.Timestamptz(6) @map("end_at")
  meetingAddress    String?            @map("meeting_address")
  meetingLatitude   Decimal?           @db.Decimal(9, 6) @map("meeting_latitude")
  meetingLongtitude Decimal?           @db.Decimal(9, 6) @map("meeting_longitude")
  proposedPrice     Decimal?           @db.Decimal(12, 0) @map("proposed_price")
  currency          String             @default("VND") @db.Char(3)
  acceptedAt        DateTime?          @db.Timestamptz(6) @map("accepted_at")
  rejectedAt        DateTime?          @db.Timestamptz(6) @map("rejected_at")
  cancelledAt       DateTime?          @db.Timestamptz(6) @map("cancelled_at")
  completedAt       DateTime?          @db.Timestamptz(6) @map("completed_at")
  cancellationReason String?            @map("cancellation_reason")
  version           Int                @default(1)

  tourist User @relation("TouristRequest", fields: [touristId], references: [id])
  guide   User @relation("GuideRequest", fields: [guideId], references: [id])

  conversation Conversation?

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([guideId, status, createdAt])
  @@index([touristId, status, createdAt])
  @@index([startAt])
  @@map("guide_requests")
}

model Conversation {
  id             String           @id @default(uuid()) @db.Uuid
  guideRequestId String?          @unique @db.Uuid @map("guide_request_id")
  type           ConversationType @default(GUIDE_REQUEST)
  lastMessageAt  DateTime?        @db.Timestamptz(6) @map("last_message_at")

  guideRequest GuideRequest? @relation(fields: [guideRequestId], references: [id])

  members  ConversationMember[]
  messages Message[]

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  conversationId String @db.Uuid @map("conversation_id")
  userId         String @db.Uuid @map("user_id")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt   DateTime  @default(now()) @db.Timestamptz(6) @map("joined_at")
  leftAt     DateTime? @db.Timestamptz(6) @map("left_at")
  lastReadAt DateTime? @db.Timestamptz(6) @map("last_read_at")
  isMuted    Boolean   @default(false) @map("is_muted")

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id              String      @id @default(uuid()) @db.Uuid
  conversationId  String      @db.Uuid @map("conversation_id")
  senderId        String      @db.Uuid @map("sender_id")
  clientMessageId String?     @map("client_message_id")
  type            MessageType @default(TEXT)
  content         String
  metadata        Json?
  replyToId       String?     @db.Uuid @map("reply_to_id")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id])

  replies Message[] @relation("MessageReplies")

  sentAt    DateTime  @default(now()) @db.Timestamptz(6) @map("sent_at")
  editedAt  DateTime? @db.Timestamptz(6) @map("edited_at")
  deletedAt DateTime? @db.Timestamptz(6) @map("deleted_at")

  @@unique([senderId, clientMessageId])
  @@index([conversationId, sentAt])
  @@map("messages")
}

model Review {
  id             String  @id @default(uuid()) @db.Uuid
  guideRequestId String  @db.Uuid @map("guide_request_id")
  reviewerId     String  @db.Uuid @map("reviewer_id")
  revieweeId     String  @db.Uuid @map("reviewee_id")
  rating         Int
  comment        String?

  reviewer User @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@unique([guideRequestId, reviewerId])
  @@index([revieweeId, createdAt])
  @@map("reviews")
}

model UserCurrentLocation {
  userId         String         @id @db.Uuid @map("user_id")
  latitude       Decimal        @db.Decimal(9, 6)
  longtitude     Decimal        @db.Decimal(9, 6) @map("longitude")
  accuracyMeters Float?         @map("accuracy_meters")
  source         LocationSource
  capturedAt     DateTime       @db.Timestamptz(6) @map("captured_at")
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6) @map("updated_at")
  expiresAt      DateTime?      @db.Timestamptz(6) @map("expires_at")

  user User @relation(fields: [userId], references: [id])

  @@index([capturedAt])
  @@map("user_current_locations")
}

model UserLocationHistory {
  id             BigInt         @id @default(autoincrement())
  userId         String         @db.Uuid @map("user_id")
  latitude       Decimal        @db.Decimal(9, 6)
  longitude      Decimal        @db.Decimal(9, 6) @map("longitude")
  accuracyMeters Float?         @map("accuracy_meters")
  source         LocationSource
  capturedAt     DateTime       @db.Timestamptz(6) @map("captured_at")
  createdAt      DateTime       @default(now()) @db.Timestamptz(6) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, capturedAt])
  @@map("user_location_histories")
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid @map("user_id")
  type        NotificationType
  channel     NotificationChannel
  title       String
  body        String
  data        Json?
  status      NotificationStatus  @default(PENDING)
  readAt      DateTime?           @db.Timestamptz(6) @map("read_at")
  deliveredAt DateTime?           @db.Timestamptz(6) @map("delivered_at")
  createdAt   DateTime            @default(now()) @db.Timestamptz(6) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("notifications")
}

model AiConversation {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @db.Uuid @map("user_id")
  title         String?
  status        AiConversationStatus @default(ACTIVE)
  provider      String               @default("gemini")
  model         String?
  lastMessageAt DateTime?            @db.Timestamptz(6) @map("last_message_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages AiMessage[]

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id               String        @id @default(uuid()) @db.Uuid
  conversationId   String        @db.Uuid @map("conversation_id")
  role             AiMessageRole
  content          String
  model            String?
  promptTokens     Int?          @map("prompt_tokens")
  completionTokens Int?          @map("completion_tokens")
  metadata         Json?

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}
