generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TOURIST
  GUIDE
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum LanguageProficiency {
  BASIC
  INTERMEDIATE
  ADVANCED
  NATIVE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum GuideVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum GuideRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ConversationType {
  GUIDE_REQUEST
  SUPPORT
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum LocationSource {
  GPS
  MANUAL
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationType {
  GUIDE_REQUEST_RECEIVED
  GUIDE_REQUEST_ACCEPTED
  GUIDE_REQUEST_REJECTED
  NEW_MESSAGE
  TRIP_REMINDER
  TRIP_COMPLETED
  NEW_REVIEW
  SYSTEM
}

enum AiConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique
  passwordHash        String     @map("password_hash")
  fullName            String     @map("full_name")
  gender              Gender?
  dateOfBirth         DateTime?  @map("date_of_birth")
  phone               String     @unique
  avatarUrl           String?    @map("avatar_url")
  role                UserRole   @default(TOURIST)
  status              UserStatus @default(ACTIVE)
  emailVerificationAt DateTime?  @map("email_verification_at")
  lastLoginAt         DateTime?  @map("last_login_at")

  guideProfile       GuideProfile?
  touristProfile     TouristProfile?
  refreshSessions    RefreshSession[]
  conversationMember ConversationMember[]
  messages           Message[]
  aiConversations    AiConversation[]

  sentGuideRequests GuideRequest[]        @relation("TouristRequest")
  guideRequest      GuideRequest[]        @relation("GuideRequest")
  reviewsGiven      Review[]              @relation("ReviewsGiven")
  reviewsReceived   Review[]              @relation("ReviewsReceived")
  currentLocation   UserCurrentLocation?
  locationHistory   UserLocationHistory[]
  notifications     Notification[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([role, status])
  @@map("users")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id") @db.Uuid
  deviceName String?   @map("device_name")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  expriesAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_sessions")
}

model GuideProfile {
  userId          String   @id @map("user_id") @db.Uuid
  bio             String?
  yearsExperience Int      @default(0) @map("years_experience")
  hourlyRate      Decimal? @map("hourly_rate") @db.Decimal(12, 0)
  city            String?

  country            String?
  currency           String                  @default("VND") @db.Char(3)
  isAvailable        Boolean                 @default(false) @map("is_available")
  verificationStatus GuideVerificationStatus @default(UNVERIFIED) @map("verification_status")
  averageRating      Decimal                 @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount        Int                     @default(0) @map("review_count")

  languages GuideLanguage[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isAvailable, verificationStatus])
  @@index([city])
  @@index([isAvailable])
  @@index([averageRating])
  @@map("guide_profiles")
}

model TouristProfile {
  userId            String   @id @map("user_id") @db.Uuid
  preferredLanguage String?  @map("preferred_language")
  nationality       String?
  interests         String[]
  travelPreferences Json?    @map("travel_preferences")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tourist_profiles")
}

model Language {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique

  name String @unique

  guides GuideLanguage[]

  @@map("languages")
}

model GuideLanguage {
  guideId          String              @map("guide_id") @db.Uuid
  languageId       String              @map("language_id") @db.Uuid
  proficiencyLevel LanguageProficiency @map("proficiency_level")
  guide            GuideProfile        @relation(fields: [guideId], references: [userId], onDelete: Cascade)

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([guideId, languageId])
  @@index([languageId])
  @@map("guide_languages")
}

model GuideRequest {
  id                 String             @id @default(uuid()) @db.Uuid
  touristId          String             @map("tourist_id") @db.Uuid
  guideId            String             @map("guide_id") @db.Uuid
  title              String
  description        String?
  status             GuideRequestStatus @default(PENDING)
  startAt            DateTime           @map("start_at") @db.Timestamptz(6)
  endAt              DateTime           @map("end_at") @db.Timestamptz(6)
  meetingAddress     String?            @map("meeting_address")
  meetingLatitude    Decimal?           @map("meeting_latitude") @db.Decimal(9, 6)
  meetingLongtitude  Decimal?           @map("meeting_longitude") @db.Decimal(9, 6)
  proposedPrice      Decimal?           @map("proposed_price") @db.Decimal(12, 0)
  currency           String             @default("VND") @db.Char(3)
  acceptedAt         DateTime?          @map("accepted_at") @db.Timestamptz(6)
  rejectedAt         DateTime?          @map("rejected_at") @db.Timestamptz(6)
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  completedAt        DateTime?          @map("completed_at") @db.Timestamptz(6)
  cancellationReason String?            @map("cancellation_reason")
  version            Int                @default(1)

  tourist User @relation("TouristRequest", fields: [touristId], references: [id])
  guide   User @relation("GuideRequest", fields: [guideId], references: [id])

  conversation Conversation?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([guideId, status, createdAt])
  @@index([touristId, status, createdAt])
  @@index([startAt])
  @@map("guide_requests")
}

model Conversation {
  id             String           @id @default(uuid()) @db.Uuid
  guideRequestId String?          @unique @map("guide_request_id") @db.Uuid
  type           ConversationType @default(GUIDE_REQUEST)
  lastMessageAt  DateTime?        @map("last_message_at") @db.Timestamptz(6)

  guideRequest GuideRequest? @relation(fields: [guideRequestId], references: [id])

  members  ConversationMember[]
  messages Message[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  conversationId String @map("conversation_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt   DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt     DateTime? @map("left_at") @db.Timestamptz(6)
  lastReadAt DateTime? @map("last_read_at") @db.Timestamptz(6)
  isMuted    Boolean   @default(false) @map("is_muted")

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id              String      @id @default(uuid()) @db.Uuid
  conversationId  String      @map("conversation_id") @db.Uuid
  senderId        String      @map("sender_id") @db.Uuid
  clientMessageId String?     @map("client_message_id")
  type            MessageType @default(TEXT)
  content         String
  metadata        Json?
  replyToId       String?     @map("reply_to_id") @db.Uuid

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id])

  replies Message[] @relation("MessageReplies")

  sentAt    DateTime  @default(now()) @map("sent_at") @db.Timestamptz(6)
  editedAt  DateTime? @map("edited_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([senderId, clientMessageId])
  @@index([conversationId, sentAt])
  @@map("messages")
}

model Review {
  id             String  @id @default(uuid()) @db.Uuid
  guideRequestId String  @map("guide_request_id") @db.Uuid
  reviewerId     String  @map("reviewer_id") @db.Uuid
  revieweeId     String  @map("reviewee_id") @db.Uuid
  rating         Int
  comment        String?

  reviewer User @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([guideRequestId, reviewerId])
  @@index([revieweeId, createdAt])
  @@map("reviews")
}

model UserCurrentLocation {
  userId         String         @id @map("user_id") @db.Uuid
  latitude       Decimal        @db.Decimal(9, 6)
  longtitude     Decimal        @map("longitude") @db.Decimal(9, 6)
  accuracyMeters Float?         @map("accuracy_meters")
  source         LocationSource
  capturedAt     DateTime       @map("captured_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt      DateTime?      @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([capturedAt])
  @@map("user_current_locations")
}

model UserLocationHistory {
  id             BigInt         @id @default(autoincrement())
  userId         String         @map("user_id") @db.Uuid
  latitude       Decimal        @db.Decimal(9, 6)
  longitude      Decimal        @map("longitude") @db.Decimal(9, 6)
  accuracyMeters Float?         @map("accuracy_meters")
  source         LocationSource
  capturedAt     DateTime       @map("captured_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, capturedAt])
  @@map("user_location_histories")
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  type        NotificationType
  channel     NotificationChannel
  title       String
  body        String
  data        Json?
  status      NotificationStatus  @default(PENDING)
  readAt      DateTime?           @map("read_at") @db.Timestamptz(6)
  deliveredAt DateTime?           @map("delivered_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("notifications")
}

model AiConversation {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  title         String?
  status        AiConversationStatus @default(ACTIVE)
  provider      String               @default("gemini")
  model         String?
  lastMessageAt DateTime?            @map("last_message_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages AiMessage[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id               String        @id @default(uuid()) @db.Uuid
  conversationId   String        @map("conversation_id") @db.Uuid
  role             AiMessageRole
  content          String
  model            String?
  promptTokens     Int?          @map("prompt_tokens")
  completionTokens Int?          @map("completion_tokens")
  metadata         Json?

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}
